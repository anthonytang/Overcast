# Public project connection details (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials: never commit real values or prefix them NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Generate once with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Sandbox only: no email sign-in is needed. This is never used in production.
SANDBOX_GUEST_EMAIL=overcast-sandbox@local.test
# Public HTTPS receiver in deployed environments; omit for local Link-only work.
PLAID_WEBHOOK_URL=
GEMINI_API_KEY=
# Override only if your Gemini project uses a different enabled model.
GEMINI_MODEL=gemini-3.8-flash
# Optional local Python decision engine. When not set, Overcast labels and
# uses the existing transparent weekday-bootstrap fallback.
ANALYTICS_URL=http://127.0.0.1:8000
